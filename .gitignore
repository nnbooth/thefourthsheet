# The Fourth Sheet: website and tooling.
# Code and docs live in git. DATA DOES NOT: every dataset lives in OneDrive
# (Projects/The Fourth Sheet/Data, found automatically on Mac or Windows, or set
# FOURTH_SHEET_DATA). See README.md.

# Data and office files
*.csv
*.xlsx
*.xls
*.docx
*.pptx
*.pdf
*.pbix
# ...except the website's own sample downloads, so every Excel/PDF/PowerPoint button works on the live site.
# Temporary (decided 6 Oct 2026): these will be built on request from the database / Power BI instead.
!media/exports/**/*.xlsx
!media/exports/**/*.pptx
!media/exports/**/*.pdf

# Secrets: copy .env.example to .env and fill it in; never commit .env
**/.env
**/.env.*.local

# Local tooling, logs and caches
.runlogs/
**/*.log
**/__pycache__/
**/*.pyc
.venv/
venv/
**/node_modules/
.vscode/
.mcp.json
.claude/

# OS clutter
.DS_Store
Thumbs.db

# LinkedIn cuts of the game video (tools/record_demo.py): not used by the site; kept in OneDrive "Media"
media/game/month-end-run-15s.*

# Local experiments, not part of the site
visuals/
